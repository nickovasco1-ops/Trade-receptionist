# ── Frontend (Vite — must be prefixed VITE_ to be exposed to the browser) ────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Crisp live chat widget ─────────────────────────────────────────────────────
# Sign up free at https://crisp.chat → add a website → copy the Website ID.
# Set colour to #FF6B2B in Crisp → Settings → Chatbox → Colors.
# Leave blank to disable the widget locally.
VITE_CRISP_WEBSITE_ID=

# ── Sentry DSN is hardcoded in index.tsx (EU region). No env var needed.
# If you want to override it at build time, add VITE_SENTRY_DSN here.

# ── Backend (Railway) ────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:3000,https://tradereceptionist.com

# ── Supabase (server-side only — service-role key bypasses RLS) ───────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Retell AI ─────────────────────────────────────────────────────────────────
# Webhooks are verified using RETELL_API_KEY as the HMAC secret (no separate webhook secret).
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Full public URL that Retell will POST call events to (set in Retell dashboard):
RETELL_WEBHOOK_URL=https://trade-receptionist-production.up.railway.app/webhooks/retell
# Optional canonical public backend base. If set, Google OAuth and Retell custom tools prefer this.
PUBLIC_API_BASE_URL=https://trade-receptionist-production.up.railway.app
# Where the customer-facing dashboard lives. The dashboard is part of the marketing
# SPA, so this is the apex domain — there is no `app.` subdomain and there never was.
# Used for lead deep-links in owner SMS, trial reminder emails and the Stripe portal
# return URL.
PUBLIC_APP_URL=https://tradereceptionist.com
# Optional explicit base URL for Retell custom tools. If omitted, the backend derives it from RETELL_WEBHOOK_URL.
RETELL_FUNCTION_BASE_URL=https://trade-receptionist-production.up.railway.app
# Termination URI of the Twilio Elastic SIP Trunk, used when importing a number into
# Retell (outbound dialling + agent binding). This is the trunk's domain, NOT a full URL.
RETELL_SIP_TERMINATION_URI=trade-receptionist-production.pstn.twilio.com

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# SID of the Elastic SIP Trunk that newly-provisioned numbers are attached to so
# inbound calls route into Retell. Without this, bought numbers don't answer.
TWILIO_SIP_TRUNK_SID=TKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe webhook signing secret — get from dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@tradereceptionist.com

# ── Calendars ─────────────────────────────────────────────────────────────────
# A tradesperson's diary lives in one of three places, whatever app they open it
# in: Google, Microsoft, or Apple iCloud. "iPhone calendar" is not a service.
#
# Google and Microsoft are OAuth, and each needs its own app registration. Apple
# needs nothing here — the tenant supplies an Apple ID and an app-specific
# password at runtime, because Apple publishes no OAuth for calendar data.

# ── Google Calendar (OAuth 2.0 — per-client user authorisation) ───────────────
# Create a project in Google Cloud Console, enable Calendar API,
# create OAuth 2.0 credentials (type: Web Application).
#
# IMPORTANT — check the OAuth consent screen's Publishing status. While it reads
# "Testing", Google expires every refresh token after 7 DAYS, shows an
# "unverified app" warning first, and caps the project at 100 users for its
# entire lifetime. Calendar scopes are "sensitive", so reaching Production needs
# Google's verification review: budget weeks, and expect a first-pass rejection.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# The OAuth callback. Set this explicitly — it WINS over the value derived from
# PUBLIC_API_BASE_URL (which would be the Railway domain).
#
# It must be on a domain you can verify in Google Search Console, because Google's
# OAuth verification rejects any authorised domain you do not own — and you do not own
# `up.railway.app`. Route it through the owned domain instead: vercel.json already
# rewrites /api/* to the Railway backend, so no new DNS record is needed.
GOOGLE_REDIRECT_URI=https://tradereceptionist.com/api/auth/google/callback
# Where to redirect the user after a successful calendar connection. Applies to
# every provider; GOOGLE_OAUTH_SUCCESS_URL is still read as a fallback.
CALENDAR_OAUTH_SUCCESS_URL=https://tradereceptionist.com/dashboard/settings
GOOGLE_OAUTH_SUCCESS_URL=https://tradereceptionist.com/dashboard/settings

# ── Microsoft Calendar (Outlook.com, Hotmail, Live, Microsoft 365) ────────────
# Register an app in Entra ID (portal.azure.com → App registrations) with
# "Accounts in any organizational directory and personal Microsoft accounts",
# add the redirect URI below as type Web, and create a client secret.
#
# Unlike Google there is no review to pass: Calendars.ReadWrite is available to
# consumer accounts with no admin consent, which makes this the cheapest
# provider to support. Unset simply means Outlook customers cannot connect —
# nothing else breaks.
MICROSOFT_CLIENT_ID=your-entra-application-client-id
MICROSOFT_CLIENT_SECRET=your-entra-client-secret
# Same as Google: set explicitly, and keep it on the owned domain via the /api/*
# rewrite. Microsoft has no verification review, so this is consistency, not a
# requirement — but one callback shape is easier to reason about than two.
MICROSOFT_REDIRECT_URI=https://tradereceptionist.com/api/auth/microsoft/callback

# ── Sentry (backend error + performance tracking — Railway runtime env) ──────
# The server only initialises Sentry when SENTRY_DSN is set (see
# server/src/instrument.ts). Leave unset locally; set on Railway to activate
# backend error capture. Get the DSN from sentry.io → your backend project →
# Settings → Client Keys (DSN). The frontend DSN is hardcoded in index.tsx.
SENTRY_DSN=https://your-backend-dsn@oXXXX.ingest.de.sentry.io/XXXX

# ── Sentry (build-time source-map upload — Railway/Vercel build env only) ────
# org=trade-receptionist  project=javascript-react  (hardcoded in vite.config.ts)
# Generate token: sentry.io → Settings → Auth Tokens → Create Token
# Required scopes: project:releases, org:read, project:write
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here

# ── Notion (internal ops dashboard — server-side only) ────────────────────────
# 1. Create an integration at notion.so/my-integrations (read + insert content)
# 2. Share the Trade Receptionist HQ page with your integration
# 3. Copy the 32-char database ID from each database URL
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_CALL_LOG_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_SUBSCRIBERS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_INCIDENTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides. Each defaults to the named live page under HQ.
NOTION_LEADS_DB_ID=62c4cf9f9fde4c91af694c7f3c362739
NOTION_ONBOARDING_DB_ID=bdaf71a769e145e08465df0680e532d8
NOTION_REVENUE_PAGE_ID=37e0e35d1b49815b8188e1e48163157a
NOTION_OWNER_DASHBOARD_PAGE_ID=3e70e35d1b4981c1b39bf1608ae03804
#
# Call Log database properties:
#   Caller Name    — Title
#   Phone (last 4) — Text
#   Postcode       — Text
#   Job Type       — Text
#   Outcome        — Select  (booked | lead_captured | enquiry | spam | voicemail | transferred | emergency | no_answer)
#   Urgency        — Select  (routine | urgent | emergency)
#   Duration       — Number
#   Subscriber     — Text
#   Timestamp      — Date
#   Recording      — URL
#
# Subscribers database properties:
#   Business Name  — Title
#   Email          — Email
#   Plan           — Select  (starter | pro | agency)
#   Signup Date    — Date
#
# Incidents database properties:
#   Error Type     — Title
#   Subscriber     — Text
#   Severity       — Select  (low | medium | high | critical)
#   Detail         — Text
#   Timestamp      — Date

# ── Admin / cron (internal use only — keep secret) ────────────────────────────
# Arbitrary strong secret (e.g. openssl rand -hex 32).
# Required by POST /admin/run-lead-followup — set ADMIN_API_KEY on Railway and
# pass it as the X-Admin-Key header from your cron job / scheduler.
ADMIN_API_KEY=your-admin-api-key-here

# Operational alerts: signups, failed signups, payment failures, cancellations,
# abandoned checkouts, and subscriber call usage at 80% / 100% of plan.
# Unset means every alert is dropped (logged as alert.no_address). Falls back to
# INTEGRITY_ALERT_EMAIL.
ALERT_EMAIL=

# Where POST /admin/check-calendars emails its findings when a tenant's diary
# credential has been rejected. Falls back to INTEGRITY_ALERT_EMAIL; unset means
# the report is returned and logged only and nobody is told. This matters most
# while the Google OAuth project is in Testing, where refresh tokens die after
# 7 days.
CALENDAR_ALERT_EMAIL=

# Comma-separated emails checked regardless of billing status (demo lines).
ALWAYS_CHECK_EMAILS=
